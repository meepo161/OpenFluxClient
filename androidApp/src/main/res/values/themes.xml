<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs the app's background
         until the first frame. The system bars stay transparent (edge to edge). -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F8F9FA</item>
        <item name="android:colorAccent">#4F7CFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
